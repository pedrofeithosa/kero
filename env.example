# Kero Mais — variáveis de ambiente (modelo SEM valores)
# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o GitHub.
# Onde pegar: Supabase > Project Settings > API

# Endereço do projeto Supabase (Project URL)
VITE_SUPABASE_URL=
SUPABASE_URL=

# Chave pública (anon / publishable key)
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Chave SECRETA de servidor (service_role). Usada só no servidor, para criar
# funcionários no admin. Nunca coloque o prefixo VITE_ nela e nunca suba para o GitHub.
SUPABASE_SERVICE_ROLE_KEY=
